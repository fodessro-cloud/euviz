# BEGIN FINILA
# Managed by scripts/deploy-webglobe.sh, edit it in the repository (deploy/htaccess).
# The old WordPress rules are saved on the server in .htaccess-wordpress-zaloha.
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# The old WordPress no longer runs: its PHP, admin and leftover folders are closed.
RewriteRule \.php$ - [F,L]
RewriteRule ^(wp-admin|wp-includes|backup|logs|tmp)(/|$) - [F,L]

# Clean addresses for the FINILA pages: /screener shows screener.html, and the
# old /screener.html and /index.html addresses redirect to /screener and /.
# A new page needs its name added to both lists.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(screener|companies|insiders|shorts|invest|property|map|groups)\.html[\s?]
RewriteRule ^(screener|companies|insiders|shorts|invest|property|map|groups)\.html$ /$1 [R=301,L]
RewriteRule ^(screener|companies|insiders|shorts|invest|property|map|groups)$ $1.html [L]

# Company pages: /stock/asml-holding shows stock/asml-holding.html, /stock/ is the A-Z list.
RewriteCond %{THE_REQUEST} \s/+stock/index\.html[\s?]
RewriteRule ^stock/index\.html$ /stock/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+stock/[a-z0-9-]+\.html[\s?]
RewriteRule ^stock/([a-z0-9-]+)\.html$ /stock/$1 [R=301,L]
RewriteRule ^stock/([a-z0-9-]+)$ stock/$1.html [L]
RewriteRule ^stock$ /stock/ [R=301,L]

# Property pages by country: /property/slovakia shows property-pages/slovakia.html. They live in
# their own folder so that /property (property.html) never meets a /property/ directory.
RewriteRule ^property/$ /property [R=301,L]
RewriteRule ^property/overvalued$ /property/undervalued [R=301,L]
RewriteCond %{THE_REQUEST} \s/+property-pages/[a-z0-9-]+\.html[\s?]
RewriteRule ^property-pages/([a-z0-9-]+)\.html$ /property/$1 [R=301,L]
RewriteRule ^property/([a-z0-9-]+)$ property-pages/$1.html [L]

# Links inside the archive point to /archiv/...: send visitors to the original
# address instead (/archiv/blog/index.html -> /blog/). Images, scripts and the
# archive's own home page (/archiv/) stay where they are.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/wp-(content|includes)/
RewriteRule ^archiv/(.+/)(index\.html)?$ /$1 [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^archiv/index\.html$ /archiv/ [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^archiv/([^/]+\.html)$ /$1 [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+/)index\.html$ /$1 [R=301,L]

# Old addresses (e.g. /blog/) keep working and show their copy from /archiv/
# without changing the address in the browser.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+/)$ archiv/$1index.html [L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ archiv/$1/index.html [L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ archiv/$1 [L]
# END FINILA
